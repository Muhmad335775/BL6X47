package com.voicereact.app

import android.app.Activity
import android.content.Intent
import android.os.Bundle
import android.widget.FrameLayout
import android.widget.Toast
import com.voicereact.app.page3.Page3Activity
import java.io.File
import kotlin.random.Random

class CinematicRecordingActivity : Activity() {

    companion object {
        const val EXTRA_AUDIO_PATH = "extra_audio_path"
    }

    private lateinit var micView: WhatsAppStyleMicView

    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)

        val audioPath = intent.getStringExtra(EXTRA_AUDIO_PATH)
        if (audioPath == null || !File(audioPath).exists()) {
            Toast.makeText(this, "No recorded audio found", Toast.LENGTH_LONG).show()
            finish()
            return
        }

        val container = FrameLayout(this).apply {
            layoutParams = FrameLayout.LayoutParams(
                FrameLayout.LayoutParams.MATCH_PARENT,
                FrameLayout.LayoutParams.MATCH_PARENT
            )
        }
        setContentView(container)

        micView = WhatsAppStyleMicView(this)
        micView.listener = object : WhatsAppStyleMicView.Listener {
            override fun onRecordingFinished(file: File, durationMs: Int) {
                val characterNumber = Random.nextInt(1, 16)
                Page3Activity.start(this@CinematicRecordingActivity, characterNumber, file.absolutePath)
                finish()
            }
        }
        container.addView(micView)
    }
}
