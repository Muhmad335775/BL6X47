<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <TextView
        android:id="@+id/cancelHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="◀ Slide to cancel"
        android:textColor="@color/cancel_hint"
        android:textSize="14sp"
        android:visibility="invisible"
        app:layout_constraintBottom_toTopOf="@id/micButton"
        app:layout_constraintEnd_toEndOf="@id/micButton"
        app:layout_constraintStart_toStartOf="@id/micButton"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/timerText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0:00"
        android:textColor="@color/timer_text"
        android:textSize="16sp"
        android:visibility="invisible"
        app:layout_constraintBottom_toBottomOf="@id/micButton"
        app:layout_constraintTop_toTopOf="@id/micButton"
        app:layout_constraintEnd_toStartOf="@id/waveform" />

    <com.voicereact.app.WaveformView
        android:id="@+id/waveform"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:visibility="invisible"
        app:layout_constraintBottom_toBottomOf="@id/micButton"
        app:layout_constraintTop_toTopOf="@id/micButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/micButton"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="16dp" />

    <com.voicereact.app.RecorderButtonView
        android:id="@+id/micButton"
        android:layout_width="64dp"
        android:layout_height="64dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="24dp"
        android:layout_marginEnd="16dp" />

</androidx.constraintlayout.widget.ConstraintLayout>
